// A user keeps trying to open generative AI apps that network protection or SmartScreen blocks
let dominiosIA = dynamic(["chatgpt.com", "chat.openai.com", "gemini.google.com", "claude.ai",
    "chat.deepseek.com", "perplexity.ai", "poe.com", "grok.com", "chat.mistral.ai"]);
DeviceEvents
| where TimeGenerated > ago(1h)
| where ActionType in ("ExploitGuardNetworkProtectionBlocked", "SmartScreenUrlWarning")
| where RemoteUrl has_any (dominiosIA)
| summarize Bloqueos = count(), Dominios = make_set(RemoteUrl, 10), Equipos = make_set(DeviceName, 10),
            Primera = min(TimeGenerated)
    by InitiatingProcessAccountName
| where Bloqueos >= 5
